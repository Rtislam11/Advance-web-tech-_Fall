const studentName = "Ahmed";


const marks = [75, 62, 48, 85, 55];


function calculateTotal(marks) {
    let total = 0;

    for (let i = 0; i < marks.length; i++) {
        total += marks[i];
    }

    return total;
}


function calculateAverage(marks) {
    const total = calculateTotal(marks);
    return total / marks.length;
}


function findHighestMark(marks) {
    let highest = marks[0];

    for (let i = 1; i < marks.length; i++) {
        if (marks[i] > highest) {
            highest = marks[i];
        }
    }

    return highest;
}


function countPassedSubjects(marks) {
    let passed = 0;

    for (let i = 0; i < marks.length; i++) {
        if (marks[i] >= 50) {
            passed++;
        }
    }

    return passed;
}


function calculateGrade(average) {
    if (average >= 80) {
        return "A";
    } else if (average >= 70) {
        return "B";
    } else if (average >= 60) {
        return "C";
    } else if (average >= 50) {
        return "D";
    } else {
        return "F";
    }
}

function getResult(average) {
    if (average >= 50) {
        return "Pass";
    } else {
        return "Fail";
    }
}


const total = calculateTotal(marks);
const average = calculateAverage(marks);
const highestMark = findHighestMark(marks);
const passedSubjects = countPassedSubjects(marks);
const grade = calculateGrade(average);
const result = getResult(average);

// Display results
console.log("Student Name: " + studentName);
console.log("Marks: " + marks);
console.log("Total: " + total);
console.log("Average: " + average);
console.log("Highest Mark: " + highestMark);
console.log("Passed Subjects: " + passedSubjects);
console.log("Grade: " + grade);
console.log("Result: " + result);
